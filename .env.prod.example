# ══════════════════════════════════════════════════════════════
# Скопируй этот файл в .env.prod и заполни все значения
# ══════════════════════════════════════════════════════════════

# PostgreSQL
POSTGRES_USER=events_user
POSTGRES_PASSWORD=ЗАМЕНИ_НА_НАДЁЖНЫЙ_ПАРОЛЬ
POSTGRES_DB=events_db

# Redis
REDIS_PASSWORD=ЗАМЕНИ_НА_НАДЁЖНЫЙ_ПАРОЛЬ_REDIS

# JWT — генерируй командой: openssl rand -hex 64
JWT_SECRET=ЗАМЕНИ_НА_СЛУЧАЙНУЮ_СТРОКУ_64_СИМВОЛА
QR_SECRET=ЗАМЕНИ_НА_ДРУГУЮ_СЛУЧАЙНУЮ_СТРОКУ_64_СИМВОЛА

# Время жизни токенов
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
